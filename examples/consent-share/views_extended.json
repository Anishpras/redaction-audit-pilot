    {
      "name": "D_pseudonym_event",
      "role": "exploratory",
      "note": "Keyed hash salted per event: the same person gets a different pseudonym in the grant and the share (behaviour of a hash operator with a random salt per entity).",
      "ops": [
        {
          "op": "pseudonym",
          "fields": [
            "identifier"
          ],
          "scope": "event"
        },
        {
          "op": "mask",
          "fields": [
            "name",
            "content"
          ]
        }
      ]
    },
    {
      "name": "E_pseudonym_run",
      "role": "exploratory",
      "note": "Keyed hash salted per run: consistent within a run, unlinkable across runs; works in streaming pipelines.",
      "ops": [
        {
          "op": "pseudonym",
          "fields": [
            "identifier"
          ],
          "scope": "run"
        },
        {
          "op": "mask",
